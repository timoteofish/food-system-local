RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true

# Supabase Database: Project "Food System" / ref quxmxltqvkncxwbcoshv.
# Use the production connection string from Supabase Project Settings > Database.
# Keep the real password only in the hosting provider environment variables.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.quxmxltqvkncxwbcoshv.supabase.co:5432/postgres
DB_PREPARED_STATEMENTS=false

# Generate strong, unique values in the hosting provider.
JWT_SECRET_KEY=replace-with-strong-random-secret
SECRET_KEY_BASE=replace-with-rails-secret

# Replace with the final public hosts before deploy.
CORS_ORIGINS=https://app.seu-dominio.com
APP_HOSTS=api.seu-dominio.com
RAILS_ASSUME_SSL=true

PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
ALLOW_SIMULATED_CHECKOUT=false
ALLOW_LEGACY_PUBLIC_MENU_BY_ID=false

FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
