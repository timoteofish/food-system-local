NODE_ENV=development
HOST=127.0.0.1
PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=food_system
MYSQL_USER=food_system
# Required in production; use the restricted food_system account, never root.
MYSQL_PASSWORD=change-this-local-database-password
MYSQL_CONNECTION_LIMIT=10
FOOD_SYSTEM_SECRET_KEY=generate-a-long-random-secret
SESSION_DAYS=7
COURIER_TOKEN_DAYS=30
ALLOW_LOCAL_HEADER=true

# Em produção local, o acesso pode ser ampliado para a rede da empresa.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
UPDATE_URL=
UPDATE_SHA256=
UPDATE_SIGNATURE=
UPDATE_PUBLIC_KEY=
UPDATE_NOTES=

# HTTPS endpoint that receives fiscal documents for authorization.
FISCAL_PROVIDER_URL=
