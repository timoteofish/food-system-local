NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FOOD_SYSTEM_DATA_DIR=./state
FOOD_SYSTEM_SECRET_KEY=generate-a-long-random-secret
SESSION_DAYS=7
COURIER_TOKEN_DAYS=30
ALLOW_LOCAL_HEADER=true

# In local production, access can be expanded to the business network.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://tauri.localhost,tauri://localhost
UPDATE_URL=
UPDATE_SHA256=
UPDATE_SIGNATURE=
UPDATE_PUBLIC_KEY=
UPDATE_NOTES=

# HTTPS endpoint that receives fiscal documents for authorization.
FISCAL_PROVIDER_URL=
