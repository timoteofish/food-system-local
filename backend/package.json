{
  "name": "food-system-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:contract": "node --test test/contract.test.js",
    "test:integration": "node --test test/integration.test.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/init-db.js",
    "db:migrate": "node src/migrate.js",
    "db:seed": "node src/seed.js",
    "db:backup": "node src/backup.js",
    "db:restore": "node src/restore.js",
    "db:update": "npm run db:backup && npm run db:migrate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "mysql2": "^3.12.0"
  }
}
