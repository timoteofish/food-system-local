{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Food System Local",
  "version": "0.1.0",
  "identifier": "com.foodsystem.local",
  "build": {
    "beforeDevCommand": "node desktop/start-local.mjs",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Food System Local",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:3000 http://127.0.0.1:4173; connect-src 'self' http://127.0.0.1:3000 http://127.0.0.1:4173; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "resources": ["../backend", "../desktop"],
    "targets": ["msi", "nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
